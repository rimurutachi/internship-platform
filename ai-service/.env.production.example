# =============================================================================
# AI SERVICE - PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.production and fill in your actual production values
# NEVER commit .env.production to GitHub!
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port (Render/Railway will set this automatically via $PORT)
PORT=8000

# Environment (production/development)
NODE_ENV=production

# Python buffering (keep as 1 for real-time logs)
PYTHONUNBUFFERED=1

# =============================================================================
# DATABASE CONFIGURATION (Optional - for future implementation)
# =============================================================================
# Get from: Supabase Dashboard → Settings → Database → Connection String
DATABASE_URL=postgresql://user:password@host:port/database

# =============================================================================
# SECURITY: CORS CONFIGURATION
# =============================================================================
# Backend URL that will call this AI service (REQUIRED)
# The AI service ONLY accepts requests from the backend (not from frontend)
# Format: https://your-backend-service.onrender.com
BACKEND_URL=https://your-backend.onrender.com

# Additional allowed origins (comma-separated)
# Typically just backend URL, but can include frontend for testing
ALLOWED_ORIGINS=https://your-backend.onrender.com,https://your-frontend.vercel.app

# =============================================================================
# SECURITY: RATE LIMITING
# =============================================================================
# Enable rate limiting in production (RECOMMENDED)
RATE_LIMIT_ENABLED=true

# Max requests per minute per IP for general endpoints
RATE_LIMIT_REQUESTS_PER_MINUTE=10

# Max requests per minute for CPU-intensive analysis endpoints
# (Lower limit to prevent resource exhaustion)
RATE_LIMIT_ANALYSIS_PER_MINUTE=5

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
# 1. AI Service is ONLY called by Backend (server-to-server communication)
# 2. Frontend NEVER calls AI service directly (security by design)
# 3. Render/Railway automatically sets $PORT environment variable
# 4. Use uvicorn with --host 0.0.0.0 to bind to all interfaces
# 5. Start command: uvicorn main:app --host 0.0.0.0 --port $PORT
# 6. Ensure BACKEND_URL matches your deployed backend service
# =============================================================================

# =============================================================================
# OPTIONAL: AI MODEL CONFIGURATION (Future Enhancement)
# =============================================================================
# If you integrate external AI APIs (OpenAI, Google AI, etc.)
# OPENAI_API_KEY=your-openai-api-key
# GOOGLE_AI_API_KEY=your-google-ai-api-key
# =============================================================================
