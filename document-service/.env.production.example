# =============================================================================
# DOCUMENT SERVICE - PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.production and fill in your actual production values
# NEVER commit .env.production to GitHub!
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=production

# HTTP API Port (Render will set this automatically)
PORT=6000

# WebSocket Port (Usually same as PORT in Render/cloud platforms)
# Render automatically handles WebSocket on the same port as HTTP
WEBSOCKET_PORT=6001

# =============================================================================
# FRONTEND URL (CORS Configuration)
# =============================================================================
# Your deployed frontend URL (Vercel)
FRONTEND_URL=https://your-frontend.vercel.app

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-production-supabase-service-key

# =============================================================================
# SUPABASE STORAGE CONFIGURATION
# =============================================================================
# Supabase Storage bucket name for documents
STORAGE_BUCKET_DOCUMENTS=documents

# Signed URL expiration time in seconds (default: 1 hour)
STORAGE_SIGNED_URL_EXPIRES=3600

# =============================================================================
# BLOCKCHAIN CONFIGURATION (Document Integrity)
# =============================================================================
# Enable blockchain hashing for document integrity
BLOCKCHAIN_ENABLED=true

# Hash algorithm for document fingerprinting
BLOCKCHAIN_HASH_ALGORITHM=sha256

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Get from: Supabase Dashboard → Settings → Database → Connection String
DATABASE_URL=postgresql://user:password@host:port/database

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Get from: Redis Cloud → Database → General → Public endpoint
# Format: redis://default:password@hostname:port or rediss:// for TLS
REDIS_URL=redis://default:password@your-redis-host:port

# =============================================================================
# SECURITY: RATE LIMITING
# =============================================================================
# Enable rate limiting in production (RECOMMENDED)
RATE_LIMIT_ENABLED=true

# Time window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window for general endpoints
RATE_LIMIT_MAX_REQUESTS=100

# Max file uploads per hour (stricter to prevent abuse)
RATE_LIMIT_UPLOAD_MAX=20

# =============================================================================
# SECURITY: FILE UPLOAD LIMITS
# =============================================================================
# Maximum file size in MB (default: 50MB)
UPLOAD_MAX_SIZE_MB=50

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
# 1. Render automatically sets PORT environment variable
# 2. WebSocket works on same port as HTTP in cloud platforms
# 3. Use WSS (secure WebSocket) URLs in frontend: wss://your-service.onrender.com
# 4. Ensure FRONTEND_URL matches your Vercel deployment for CORS
# =============================================================================
