# Server Configuration
NODE_ENV=development
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Database
DATABASE_URL=postgresql://user:password@host:port/database

# JWT Secret
JWT_SECRET=your-jwt-secret-key

# Redis Configuration
REDIS_URL=redis://localhost:6379

# AI Service URL
AI_SERVICE_URL=http://localhost:8000

# Document Service URL
DOCUMENT_SERVICE_URL=http://localhost:6001

# =============================================================================
# SECURITY: Rate Limiting Configuration
# =============================================================================
# Feature flag to enable/disable rate limiting (default: true)
RATE_LIMIT_ENABLED=true
# Time window for rate limiting in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window for general endpoints (default: 100 for production)
RATE_LIMIT_MAX_REQUESTS=100
# Max requests per window for auth endpoints - stricter (default: 5)
RATE_LIMIT_AUTH_MAX=5

# =============================================================================
# SECURITY: Test Mode Configuration (DEVELOPMENT ONLY)
# =============================================================================
# Set to 'true' ONLY in test environment (never in production)
ALLOW_TEST_MODE=false
# Role for test user (required if ALLOW_TEST_MODE=true)
TEST_USER_ROLE=student
