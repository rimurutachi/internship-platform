# Server Configuration
PORT=8000
NODE_ENV=development

# Database (if needed for future implementation)
DATABASE_URL=postgresql://user:password@host:port/database

# Python Environment
PYTHONUNBUFFERED=1

# =============================================================================
# SECURITY: CORS Configuration
# =============================================================================
# Backend URL for CORS (required - AI service only accepts requests from backend)
BACKEND_URL=http://localhost:5000
# Additional allowed origins (comma-separated, optional)
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000

# =============================================================================
# SECURITY: Rate Limiting Configuration
# =============================================================================
# Feature flag to enable/disable rate limiting (default: true)
RATE_LIMIT_ENABLED=true
# Max requests per minute per IP for general endpoints (default: 10)
RATE_LIMIT_REQUESTS_PER_MINUTE=10
# Max requests per minute for CPU-intensive analysis endpoints (default: 5)
RATE_LIMIT_ANALYSIS_PER_MINUTE=5
