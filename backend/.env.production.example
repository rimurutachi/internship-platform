# =============================================================================
# BACKEND SERVICE - PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.production and fill in your actual production values
# NEVER commit .env.production to GitHub!
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=5000

# =============================================================================
# FRONTEND & SERVICE URLs (CORS & Communication)
# =============================================================================
# Your deployed frontend URL (Vercel)
FRONTEND_URL=https://your-frontend.vercel.app

# Document service URL (Render)
DOCUMENT_SERVICE_URL=https://your-document-service.onrender.com

# AI service URL (Render/Railway)
AI_SERVICE_URL=https://your-ai-service.onrender.com

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-production-supabase-service-key

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Get from: Supabase Dashboard → Settings → Database → Connection String
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@host:port/database

# =============================================================================
# JWT SECRET (CRITICAL - GENERATE A STRONG SECRET!)
# =============================================================================
# Generate with: openssl rand -base64 32
# NEVER use the same secret as development!
JWT_SECRET=your-production-jwt-secret-CHANGE-THIS-TO-RANDOM-64-CHAR-STRING

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Get from: Redis Cloud → Database → General → Public endpoint
# Format: redis://default:password@hostname:port or rediss:// for TLS
REDIS_URL=redis://default:password@your-redis-host:port

# =============================================================================
# SECURITY: RATE LIMITING
# =============================================================================
# Enable rate limiting in production (RECOMMENDED)
RATE_LIMIT_ENABLED=true

# Time window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window for general endpoints
RATE_LIMIT_MAX_REQUESTS=100

# Max requests per window for auth endpoints (stricter)
RATE_LIMIT_AUTH_MAX=5

# =============================================================================
# SECURITY: TEST MODE (PRODUCTION = ALWAYS FALSE!)
# =============================================================================
# NEVER enable test mode in production!
ALLOW_TEST_MODE=false

# Test user role (ignored in production)
TEST_USER_ROLE=student
