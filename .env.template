# ===========================================
# INTERNSHIP PLATFORM - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file and rename to: .env
# Fill in your actual Supabase credentials before running docker-compose up

# ===========================================
# SUPABASE CONFIGURATION (REQUIRED)
# ===========================================
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# Frontend public keys (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ===========================================
# DATABASE CONFIGURATION (REQUIRED)
# ===========================================
# Get from: https://app.supabase.com/project/YOUR_PROJECT/settings/database
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ===========================================
# JWT SECRET (REQUIRED)
# ===========================================
# Generate a random string (min 32 characters)
# Example: openssl rand -base64 32

JWT_SECRET=change-this-to-a-random-secret-key-min-32-chars

# ===========================================
# OPTIONAL: Advanced Configuration
# ===========================================

# Frontend URL (for CORS)
# FRONTEND_URL=http://localhost:3000

# Backend API URL
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
# NEXT_PUBLIC_BACKEND_SOCKET_URL=http://localhost:5000

# Document Service WebSocket
# NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:6000

# AI Service URL
# AI_SERVICE_URL=http://localhost:8000

# Redis URL (default is fine for Docker)
# REDIS_URL=redis://redis:6379

# Node Environment
# NODE_ENV=production

# ===========================================
# NOTES:
# ===========================================
# 1. Never commit this file to Git (.gitignore blocks it)
# 2. Keep SUPABASE_SERVICE_KEY secret (don't share publicly)
# 3. Use different keys for production vs development
# 4. Generate JWT_SECRET: openssl rand -base64 32
