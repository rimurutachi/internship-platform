# Server Configuration
PORT=8000
NODE_ENV=development

# Database (if needed for future implementation)
DATABASE_URL=postgresql://user:password@host:port/database

# Python Environment
PYTHONUNBUFFERED=1

# =============================================================================
# SECURITY: CORS Configuration
# =============================================================================
# Backend URL for CORS (required - AI service only accepts requests from backend)
BACKEND_URL=http://localhost:5000
# Additional allowed origins (comma-separated, optional)
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000

# =============================================================================
# SECURITY: Rate Limiting Configuration
# =============================================================================
# Feature flag to enable/disable rate limiting (default: true)
RATE_LIMIT_ENABLED=true
# Max requests per minute per IP for general endpoints (default: 10)
RATE_LIMIT_REQUESTS_PER_MINUTE=10
# Max requests per minute for CPU-intensive analysis endpoints (default: 5)
RATE_LIMIT_ANALYSIS_PER_MINUTE=5

# =============================================================================
# GEMINI API CONFIGURATION (DTR & Signature Scanning, Report Summaries)
# =============================================================================
# Google AI Studio API Key (supports single key or comma-separated keys for rotation)
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEYS=key1,key2

# Primary AI Model (gemini-3.5-flash-lite recommended for 500 RPD on Free Tier)
GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback models (comma-separated list tried automatically if quota 429 is hit)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.5-flash,gemini-3-flash,gemini-2.5-flash

