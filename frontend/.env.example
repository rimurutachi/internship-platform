# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Backend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_BACKEND_SOCKET_URL=http://localhost:5000

NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# Document Service (single port for HTTP + WebSocket)
NEXT_PUBLIC_DOCUMENT_SERVICE_URL=http://localhost:6001
NEXT_PUBLIC_WEBSOCKET_URL=http://localhost:6001

# Optional: Application URL (for metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000

# E2E Testing Credentials
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=password123
TEST_SUPERVISOR_EMAIL=supervisor@example.com
TEST_SUPERVISOR_PASSWORD=password123
TEST_STUDENT_EMAIL=student@example.com
TEST_STUDENT_PASSWORD=password123
TEST_ADVISOR_EMAIL=advisor@example.com
TEST_ADVISOR_PASSWORD=password123
